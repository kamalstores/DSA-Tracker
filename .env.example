# Frontend environment — copy to .env.local and fill in.
# Supabase Dashboard → Project Settings → API.
# The anon key is PUBLIC by design; all protection is Row Level Security.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Optional: live cross-device sync via Supabase Realtime.
# Requires running (once, in the SQL editor):
#   alter publication supabase_realtime add table public.user_progress;
VITE_ENABLE_REALTIME=false
